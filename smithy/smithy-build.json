{
  "version": "1.0",
  "sources": ["models"],
  "maven": {
    "dependencies": []
  },
  "projections": {
    "openapi": {
      "plugins": {
        "openapi": {
          "service": "layertwo.cortex#Cortex",
          "protocol": "aws.protocols#restJson1",
          "version": "3.0.2",
          "apiGatewayType": "REST",
          "disableCloudFormationSubstitution": true
        }
      }
    },
    "typescript": {
      "plugins": {
        "typescript-client-codegen": {
          "package": "@cortex/client",
          "packageVersion": "0.1.0",
          "service": "layertwo.cortex#Cortex",
          "protocol": "aws.protocols#restJson1"
        }
      }
    }
  }
}
