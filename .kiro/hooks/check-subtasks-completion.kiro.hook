{
  "enabled": true,
  "name": "Check Subtasks Completion",
  "description": "At the end of each agent session, verify if all associated subtasks have been completed. If not, continue working on the remaining subtasks.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If you were originally invoked by the user for a Kiro task, review the current task and all associated subtasks. Check if all subtasks have been completed. If any subtasks remain incomplete, list them and and if the user if they would like you to continue. If all subtasks are complete, confirm completion and summarize what was accomplished."
  },
  "workspaceFolderName": "cortex",
  "shortName": "check-subtasks-completion"
}